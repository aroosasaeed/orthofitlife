# ---------------------------------------------------------------------------
# OrthofitLife environment variables
# Copy this file to .env.local and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Customer support contact details (placeholder values until design approval)
NEXT_PUBLIC_CONTACT_EMAIL=hello@orthofitlife.com
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE_NUMBER=

# Social (optional)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Data source: "mock" (local sample data) or a future commerce backend id
NEXT_PUBLIC_DATA_SOURCE=mock

# / Analytics program (add provider IDs after going live)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
